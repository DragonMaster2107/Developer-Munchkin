@page "/spiel"
@using DeveloperDungeon.Engine.Commands
@using DeveloperDungeon.Engine.Events
@using DeveloperDungeon.Engine.Cards
@using DeveloperDungeon.Engine.State
@using DeveloperDungeon.Web.Components
@using DeveloperDungeon.Web.Logic
@implements IDisposable
@inject TableController Game
@inject NavigationManager Nav
@inject SettingsStore Settings

<PageTitle>Developer Dungeon – Spiel</PageTitle>

@if (Game.HasGame)
{
    var view = Game.View;
    ReconcileSelection(view);
    @if (view.WinnerId is { } winnerId)
    {
        <div class="victory" role="dialog" aria-modal="true" aria-label="Sieg">
            <h1>@view.Players.First(p => p.Id == winnerId).Name ist CTO!</h1>
            <button type="button" class="dd-button" @onclick='() => Nav.NavigateTo("")'>Zur Startseite</button>
        </div>
    }
    else if (Game.HandoffTargetId is { } targetId)
    {
        var target = view.Players.First(p => p.Id == targetId);
        <HandoffScreen PlayerName="@target.Name" Color="@target.Color" OnReveal="Game.ConfirmHandoff" />
    }
    else
    {
        var actorId = Game.ActorId;
        var giveAway = ActionBar.GiveAwayFor(view, actorId);
        <div class="@(_shake ? "table shake" : "table")">
            <div class="table-players">
                <PlayerBar View="view" Catalog="Game.Catalog" CanInterject="@(view.Phase != GamePhase.Setup && Game.InterjectorId is null)" OnInterject="Game.BeginInterjection" />
                <button type="button" class="dd-button toolbox-toggle" aria-label="Werkzeugkasten" aria-expanded="@(_toolbox ? "true" : "false")" title="Werkzeugkasten" @onclick="() => _toolbox = !_toolbox">
                    <svg class="toolbox-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M14.7 6.3a4 4 0 0 0 5 5L21 12.6a1 1 0 0 1 0 1.4l-1 1-3.3-3.3-9.4 9.4a2.1 2.1 0 0 1-3-3l9.4-9.4L9.4 5.4l1-1a1 1 0 0 1 1.4 0z" />
                    </svg>
                </button>
            </div>

            @if (view.Phase == GamePhase.Setup && Game.SetupPlayerId is { } setupId)
            {
                <div class="table-band dd-panel" role="status">
                    <span>Aufbau-Runde: @view.Players.First(p => p.Id == setupId).Name legt Abteilung, Sprache und Ausrüstung aus</span>
                    <button type="button" class="dd-button" @onclick="Game.FinishSetupForCurrentAsync">Fertig</button>
                </div>
            }
            else if (Game.InterjectorId is { } interjectorId)
            {
                <div class="table-band dd-panel" role="status">
                    <span>@view.Players.First(p => p.Id == interjectorId).Name greift ein</span>
                    <button type="button" class="dd-button" @onclick="Game.EndInterjection">Fertig</button>
                </div>
            }

            @if (_toolbox)
            {
                <div class="table-toolbox">
                    <ToolboxPanel OnClose="() => _toolbox = false" />
                </div>
            }

            <div class="table-middle">
                <DeckArea View="view" Catalog="Game.Catalog" OnZoom="c => _zoom = c" />
                <CombatArea Catalog="Game.Catalog" CountdownSeconds="_countdownSeconds" />
            </div>

            <section class="hand-area dd-panel">
                <PlayerArea SelectMode="@(giveAway > 0)" Selected="_selected" OnToggle="ToggleSelected" />
                <ActionBar View="view" ActorId="@actorId" Selected="_selected" OnCommand="SendCommand" />
            </section>

            <aside class="table-log">
                <LogPanel View="view" />
            </aside>
        </div>
        <ChoiceDialog View="view" Catalog="Game.Catalog" />
        <ManualEffectDialog Card="ManualEffectCard" OnClose="DismissManualEffect" />
    }
}

<AnimationLayer Enabled="_animations" OnActiveChanged="k => { _shake = k == CueKind.ScreenShake; StateHasChanged(); }" />
<Toast />
<CardZoom Card="_zoom" OnClose="() => _zoom = null" />

@code {
    private readonly HashSet<int> _selected = [];
    private CardDefinition? _zoom;
    private bool _toolbox;
    private bool _shake;
    private bool _animations = true;
    private string? _selectedFor;
    private int _countdownSeconds = new GameSettings().CountdownSeconds;
    private IReadOnlyList<GameEvent>? _dismissedEvents;

    /// <summary>Karte der zuletzt gemeldeten manuellen Wirkung, bis sie geschlossen wird.</summary>
    private CardDefinition? ManualEffectCard =>
        ReferenceEquals(Game.LastEvents, _dismissedEvents) || Game.LastEvents.OfType<ManualEffectShown>().FirstOrDefault() is not { } shown
            ? null
            : Game.Catalog.Get(shown.CardId);

    private void DismissManualEffect() => _dismissedEvents = Game.LastEvents;

    /// <summary>Gleicht die Auswahl mit der aktuell aufgedeckten Hand ab: fremde oder verschwundene Karten fallen heraus.</summary>
    private void ReconcileSelection(DeveloperDungeon.Engine.Views.GameView view)
    {
        if (_selectedFor != Game.RevealedPlayerId)
        {
            _selected.Clear();
            _selectedFor = Game.RevealedPlayerId;
        }
        _selected.IntersectWith((view.MyHand ?? []).Select(c => c.InstanceId));
    }

    protected override async Task OnInitializedAsync()
    {
        // Nach einem Neuladen auf /spiel ist der Speicher leer: erst den Spielstand laden, sonst zur Startseite.
        if (!Game.HasGame && await Game.TryResumeAsync() != ResumeResult.Resumed)
        {
            Nav.NavigateTo("", replace: true);
            return;
        }

        Game.Changed += OnChanged;
        var settings = await Settings.LoadAsync();
        _countdownSeconds = settings.CountdownSeconds;
        _animations = settings.AnimationsEnabled;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void ToggleSelected(int id)
    {
        if (!_selected.Remove(id))
        {
            _selected.Add(id);
        }
    }

    private async Task SendCommand(GameCommand command)
    {
        var result = await Game.SendAsync(command);
        if (result.Accepted && command is EndTurn)
        {
            _selected.Clear();
        }
    }

    public void Dispose() => Game.Changed -= OnChanged;
}
