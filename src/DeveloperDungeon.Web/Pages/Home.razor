@page "/"
@using DeveloperDungeon.Engine.State
@using DeveloperDungeon.Web.Logic
@inject TableController Table
@inject NavigationManager Nav

<PageTitle>Developer Dungeon</PageTitle>

<h1>Developer Dungeon</h1>

@if (_loaded)
{
    @if (_result == ResumeResult.Incompatible)
    {
        <p class="dd-panel home-hint" role="alert">Der gespeicherte Spielstand passt nicht mehr zu dieser Version.</p>
    }
    @if (_warning is not null)
    {
        <p class="dd-panel home-hint" role="alert">@_warning</p>
    }
    <nav class="home-menu">
        @if (_result == ResumeResult.Resumed)
        {
            <button type="button" class="dd-button" @onclick='() => Nav.NavigateTo("spiel")'>@ResumeLabel</button>
        }
        <a class="dd-button" href="neu">Neues Spiel</a>
        <a class="dd-button" href="regeln">Regeln</a>
        <a class="dd-button" href="karten">Kartengalerie</a>
        <a class="dd-button" href="einstellungen">Einstellungen</a>
    </nav>
}

@code {
    private bool _loaded;
    private ResumeResult _result;
    private string? _warning;

    private string ResumeLabel =>
        Table.HasGame && Table.View.Phase == GamePhase.GameOver ? "Letzte Partie ansehen" : "Fortsetzen";

    protected override async Task OnInitializedAsync()
    {
        if (Table.HasGame && Table.LastWarning is not null)
        {
            // Der Spielstand im Speicher ist neuer als der gespeicherte: nicht neu laden, sonst ginge Fortschritt verloren.
            _warning = Table.LastWarning;
            _result = ResumeResult.Resumed;
        }
        else
        {
            _result = await Table.TryResumeAsync();
        }
        _loaded = true;
    }
}
