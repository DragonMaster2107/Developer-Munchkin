@using DeveloperDungeon.Web.Logic
@implements IDisposable
@inject TableController Table

@if (_text is not null)
{
    <div class="toast" role="alert">@_text</div>
}

@code {
    private static readonly TimeSpan Duration = TimeSpan.FromSeconds(4);

    private string? _text;
    private int _seenVersion;
    private Timer? _timer;

    protected override void OnInitialized()
    {
        _seenVersion = Table.FeedbackVersion;
        Table.Changed += OnChanged;
    }

    private void OnChanged()
    {
        if (Table.FeedbackVersion == _seenVersion)
        {
            return;
        }

        _seenVersion = Table.FeedbackVersion;
        var message = Table.Feedback;
        _ = InvokeAsync(() =>
        {
            _text = message;
            _timer?.Dispose();
            _timer = new Timer(_ => _ = InvokeAsync(Hide), null, Duration, Timeout.InfiniteTimeSpan);
            StateHasChanged();
        });
    }

    private void Hide()
    {
        _text = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        Table.Changed -= OnChanged;
        _timer?.Dispose();
    }
}
