@inject TimeProvider Time

<div class="handoff" style="background:@Color" role="dialog" aria-modal="true" aria-label="Gerät übergeben">
    <h1>Gib das Gerät an @PlayerName</h1>
    <button type="button" class="dd-button" @onclick="RevealAsync">Ich bin @PlayerName – aufdecken</button>
</div>

@code {
    /// <summary>So lange nach dem Erscheinen zählen Klicks nicht: Ein Doppeltipp der vorigen Person deckt sonst die fremde Hand auf.</summary>
    public static readonly TimeSpan RevealGuard = TimeSpan.FromMilliseconds(400);

    private DateTimeOffset _shownAt;
    private string? _shownFor;

    [Parameter, EditorRequired] public string PlayerName { get; set; } = "";
    [Parameter, EditorRequired] public string Color { get; set; } = "#ffffff";
    [Parameter] public EventCallback OnReveal { get; set; }

    protected override void OnParametersSet()
    {
        if (_shownFor != PlayerName)
        {
            _shownFor = PlayerName;
            _shownAt = Time.GetUtcNow();
        }
    }

    private async Task RevealAsync()
    {
        if (Time.GetUtcNow() - _shownAt < RevealGuard)
        {
            return;
        }
        await OnReveal.InvokeAsync();
    }
}
